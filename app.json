{
  "expo": {
    "name": "fooder",
    "slug": "fooder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fooder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "fooder 需要访问相册以选择菜品图片",
        "NSCameraUsageDescription": "fooder 需要使用相机拍摄菜品照片",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "fooder 数据包",
            "LSHandlerRank": "Owner",
            "CFBundleTypeExtensions": [
              "fooder",
              "guorizi"
            ],
            "LSItemContentTypes": [
              "com.fooder.datapackage"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.fooder.datapackage",
            "UTTypeDescription": "fooder 数据包",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "fooder",
                "guorizi"
              ]
            }
          }
        ]
      }
    },
    "android": {
      "package": "com.henry.fooder",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "mimeType": "*/*",
              "host": "*",
              "scheme": "file",
              "pathPattern": ".*\\.fooder"
            },
            {
              "mimeType": "*/*",
              "host": "*",
              "scheme": "content",
              "pathPattern": ".*\\.fooder"
            },
            {
              "mimeType": "*/*",
              "host": "*",
              "scheme": "file",
              "pathPattern": ".*\\.guorizi"
            },
            {
              "mimeType": "*/*",
              "host": "*",
              "scheme": "content",
              "pathPattern": ".*\\.guorizi"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "fooder 需要访问相册以选择菜品图片",
          "cameraPermission": "fooder 需要使用相机拍摄菜品照片"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "position": "relative",
          "behavior": "inset-swipe"
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8e9d9d7-1cf3-4f0f-b0fa-79a6644195e2"
      }
    }
  }
}
