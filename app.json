{
  "expo": {
    "name": "fooder",
    "slug": "fooder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fooder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "fooder 需要访问相册以选择菜品图片",
        "NSCameraUsageDescription": "fooder 需要使用相机拍摄菜品照片",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "fooder 数据包",
            "LSHandlerRank": "Owner",
            "CFBundleTypeExtensions": ["fooder"],
            "LSItemContentTypes": ["com.fooder.datapackage"]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.fooder.datapackage",
            "UTTypeDescription": "fooder 数据包",
            "UTTypeConformsTo": ["public.data"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["fooder"]
            }
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6B35",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FF6B35"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "fooder 需要访问相册以选择菜品图片",
          "cameraPermission": "fooder 需要使用相机拍摄菜品照片"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "position": "relative",
          "behavior": "inset-swipe"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
